+/* ============================================================
+   FormH — added for the H-section redesign (numbering badges,
+   card-header alignment, checkbox groups, dynamic Infection list)
+   ============================================================ */
+
+/* ===== SECTION / SUBSECTION NUMBERING BADGES ===== */
+.sec-num {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  font-size: 11px;
+  font-weight: 800;
+  letter-spacing: .02em;
+  color: #0369a1;
+  background: #e0f2fe;
+  border-radius: 6px;
+  padding: 2px 7px;
+  margin-right: 8px;
+  vertical-align: middle;
+}
+.sec-num.sub {
+  color: #4338ca;
+  background: #eef2ff;
+}
+
+/* ===== CARD HEADER ALIGNMENT (right-section / arrow / summary pill) ===== */
+.card-header-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  cursor: pointer;
+}
+.card-header-row > span:first-child {
+  font-weight: 650;
+  font-size: 14px;
+  color: #1e293b;
+}
+.right-section {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  margin-left: auto;
+}
+.arrow {
+  font-size: 11px;
+  color: var(--portal-muted, #64748b);
+  margin-left: 6px;
+  user-select: none;
+}
+.summary {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  font-size: 12px;
+  font-weight: 650;
+  padding: 4px 10px;
+  border-radius: 999px;
+  background: #f1f5f9;
+  color: #475569;
+  white-space: nowrap;
+}
+.summary .icon { font-size: 12px; line-height: 1; }
+.summary.yes { background: #fef2f2; color: #b91c1c; }
+.summary.no { background: #f0fdf4; color: #15803d; }
+.summary.empty { background: #f1f5f9; color: #64748b; }
+.summary.centered { justify-content: center; }
+
+/* ===== CHECKBOX GROUP CARD (used throughout FormH: sepsis, ROP, feed intolerance, etc.) ===== */
+.pn-adverse-card {
+  background: #f8fafc;
+  border: 1px solid var(--portal-border, #e2e8f0);
+  border-radius: 12px;
+  padding: 16px 18px;
+  margin: 14px 0;
+}
+.adverse-title {
+  font-weight: 650;
+  font-size: 13px;
+  color: #1e3a5f;
+  margin: 14px 0 10px;
+}
+.adverse-title:first-child { margin-top: 0; }
+.pn-checkbox-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
+  gap: 10px 18px;
